pipeline:
  name: calculator-app
  id: calculator_app
  stages:
    - id: pythonPipBuildTestHostedLinuxStage_1
      name: Python pip Build and Test on Harness Cloud (Linux)
      clone:
        enabled: true
      cache:
        enabled: false
        paths:
          - .harness-cache/pip
        key: <+pipeline.identifier>-python-pip-{{ checksum "requirements.txt" }}
        policy: pull-push
      steps:
        - id: setupPython
          name: Setup Python
          template:
            uses: setupPython@1.0.0
            with:
              version: 3.10.14
        - id: installDependenciesLinux
          name: Install Dependencies on Linux
          run:
            shell: bash
            script: python3 -m pip install pytest-cov
        - id: testLinux
          name: Test on Linux
          run-test:
            shell: bash
            script: echo "9" | python3 calculate.py
            intelligence:
              disabled: true
